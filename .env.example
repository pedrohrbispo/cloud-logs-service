# Copy to .env and adjust. `.env` is gitignored.

# ── BFF ──────────────────────────────────────────────────────────────────
ENV=dev
PORT=8080

# JWT signing secret — MUST be >= 32 bytes. The server refuses to start if it
# is shorter. Generate a strong one with:
#     openssl rand -base64 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
JWT_EXPIRY=1h
JWT_ISSUER=cloud-log-access-service
JWT_AUDIENCE=cloud-log-access-service

# Comma-separated allowed CORS origins. NEVER use "*".
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── AWS S3 / LocalStack (consumed from B2) ───────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_EC2_METADATA_DISABLED=true
S3_INTERNAL_ENDPOINT=http://localstack:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566
S3_USE_PATH_STYLE=true

# ── Pre-signed URL TTL bounds (consumed from B4) ─────────────────────────
PRESIGN_MIN_TTL=60s
PRESIGN_MAX_TTL=15m

# ── Azure / Azurite (consumed from B3) ───────────────────────────────────
# This is Microsoft's PUBLIC, well-known Azurite development key. It is NOT a
# secret, is intentionally hardcoded in the emulator, and must never be used in
# production. Documented here so secret scanners do not flag it.
AZURE_STORAGE_ACCOUNT=devstoreaccount1
AZURE_STORAGE_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
