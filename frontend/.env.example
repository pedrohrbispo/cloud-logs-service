# API base path baked into the bundle at build time.
# Same-origin in dev (Vite proxy) and prod (nginx /api proxy) → zero CORS.
VITE_API_BASE=/api/v1

# Dev-only: where the Vite dev server proxies /api/* to (the Go BFF).
# Defaults to http://localhost:8080 if unset.
VITE_PROXY_TARGET=http://localhost:8080

# Dev/demo-only: when "true", the SPA boots an in-browser mock of the BFF (MSW)
# so it runs end-to-end with NO backend. Use `npm run dev:mock`. Never set in prod.
VITE_USE_MOCKS=false
